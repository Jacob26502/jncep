# Variables for the Portainer stack (Environment variables > "Load variables from
# .env file") or for a local .env file. .env is ignored by git.

# J-Novel Club account
JNCEP_EMAIL=user@example.com
JNCEP_PASSWORD=

# Shared secret Activepieces must send in the X-Webhook-Token header
JNCEP_WEBHOOK_TOKEN=change-me

# API key of the Kavita admin user (Kavita > User settings > 3rd Party Clients)
# Leave empty on first deploy: the webhook runs without rescanning Kavita
JNCEP_KAVITA_API_KEY=

# Host folder holding the books (default /data/books)
# BOOKS_DIR=/data/books

# Domain for Kavita behind Traefik (default kavita.rafu.moe)
# KAVITA_HOST=kavita.rafu.moe
